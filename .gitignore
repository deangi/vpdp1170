# Upstream reference material (clones of sam11 / sam11-derived sources used
# while building cpu_pdp11.cpp). Not needed to build - the aggregated
# translation unit is committed.
_upstream_sam11/

# Build artifacts (Arduino sketch build dumps, capture logs, VS harness)
build/
tools/kek_vs_core/build-min/
*.bin

# Plan / scratch
*.tmp

# Disk images - keep local copies but don't bloat git with multi-MB binaries.
DiskImages/
*.dsk
*.DSK
*.hdd
*.img
*.iso
*.ISO
*.rl01
*.rl02
*.zip

# Local-only Elecrow bring-up sketch (not part of the shipped firmware).
CrowPanelBringup/

# Python caches (diagnostics toolkit, font tools)
__pycache__/
*.pyc
